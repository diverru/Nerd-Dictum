{
  "name": "nerd-dictum",
  "version": "0.9.2",
  "description": "A minimal floating window for voice-to-text transcription using Google Gemini",
  "type": "module",
  "main": "dist/main/main.js",
  "author": {
    "name": "Arseny Pavlenko",
    "email": "ArsenyPavlenko@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "bun run build:main && bun run build:preload && bun run build:swift && concurrently --kill-others --success first \"vite\" \"wait-on http://localhost:${VITE_PORT:-12000} && NODE_ENV=development electron .\"",
    "dev:fast": "bun run scripts/dev-fast.ts",
    "dev:mac:build": "bun run build && ./node_modules/.bin/electron-builder --mac dir -c.mac.identity=null",
    "dev:mac:stop": "pkill -f '/release/mac-arm64/Nerd Dictum.app/Contents/MacOS/Nerd Dictum' || true",
    "dev:mac": "bun run dev:mac:stop && mkdir -p .dev3/tmp && touch .dev3/tmp/dev-mac.stdout.log .dev3/tmp/dev-mac.stderr.log && trap 'bun run dev:mac:stop' EXIT INT TERM && open -W -n --env LOCAL_DEV_BUILD=true --stdout .dev3/tmp/dev-mac.stdout.log --stderr .dev3/tmp/dev-mac.stderr.log './release/mac-arm64/Nerd Dictum.app'",
    "dev:mac:logs": "mkdir -p .dev3/tmp && touch .dev3/tmp/dev-mac.stdout.log .dev3/tmp/dev-mac.stderr.log && tail -n 200 -f ~/Library/Logs/Nerd\\ Dictum/main.log .dev3/tmp/dev-mac.stdout.log .dev3/tmp/dev-mac.stderr.log",
    "dev:mac:tmux": "if [ -n \"$TMUX\" ]; then tmux split-window -v -c \"$PWD\" 'bun run dev:mac:logs'; tmux select-layout even-vertical; fi && bun run dev:mac",
    "build": "bun run build:main && bun run build:preload && bun run build:swift && vite build",
    "build:main": "bun build src/main/main.ts --outdir dist/main --target node --external electron --external onnxruntime-node --external @picovoice/pvrecorder-node --external undici",
    "build:preload": "bun build src/preload/preload.ts --outdir dist/preload --target node --external electron --format cjs",
    "build:swift": "bun run scripts/build-swift.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:renderer": "vite",
    "dist": "bun run build && APPLE_KEYCHAIN_PROFILE=AC_PASSWORD electron-builder --mac",
    "dist:unsigned": "bun run build && electron-builder --mac -c.mac.identity=null",
    "dist:win": "bun run build && electron-builder --win",
    "dist:linux": "bun run build && electron-builder --linux",
    "release": "bun run build && APPLE_KEYCHAIN_PROFILE=AC_PASSWORD electron-builder --mac --publish always",
    "bump": "bun run scripts/bump.ts",
    "bump:minor": "bun run scripts/bump.ts minor",
    "bump:major": "bun run scripts/bump.ts major"
  },
  "build": {
    "appId": "com.h0x91b.nerddictum",
    "productName": "Nerd Dictum",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "copyright": "Copyright © 2026 Arseny Pavlenko",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "!node_modules/**/README*",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/*.md"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "swift/.build/release/parakeet-bridge",
        "to": "bin/parakeet-bridge"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        },
        {
          "target": "zip",
          "arch": "universal"
        }
      ],
      "identity": "Arseny Pavlenko (7972FR33R4)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "This app needs microphone access to record and transcribe your voice.",
        "NSAppleEventsUsageDescription": "Nerd Dictum needs to send a paste keystroke (⌘V) so the transcript appears at your cursor."
      },
      "notarize": true,
      "singleArchFiles": "**/{uiohook-napi,onnxruntime-node,@picovoice/pvrecorder-node}/**/*.{node,dylib}",
      "x64ArchFiles": "**/{uiohook-napi,onnxruntime-node,@picovoice/pvrecorder-node}/**/*.{node,dylib}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "owner": "h0x91b",
      "repo": "Nerd-Dictum",
      "private": false
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.11",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/bun": "latest",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.4.0",
    "happy-dom": "^20.0.11",
    "typescript": "^5.0.0",
    "vite": "^7.3.0",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.75",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/openai": "^3.0.61",
    "@picovoice/pvrecorder-node": "^1.2.8",
    "ai": "^6.0.175",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "onnxruntime-node": "^1.25.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "uiohook-napi": "^1.5.5"
  }
}
